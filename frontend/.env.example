# Copy to .env.local and fill in. Never put the service-role / secret key here.
# Local stack: run `supabase start` (or `supabase status`) in the repository root
# and copy "API URL" and the anon / publishable key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public demo only: one-click demo logins, a "resets every 6 hours" banner, and demo
# accounts that cannot change their password or email. Leave unset elsewhere.
# VITE_DEMO_MODE=true
# VITE_DEMO_PASSWORD=the DEMO_PASSWORD used by scripts/seed-demo.mjs (public on purpose)

# "Continue with Google / Facebook" on the login and sign-up pages (comma list, shown in this
# order). Only list providers that are switched on in Supabase Auth (supabase/README.md,
# "Enable Google / Facebook sign-in"). Unset = email and password only.
# VITE_AUTH_PROVIDERS=google,facebook
