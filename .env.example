# Backend scripts (scripts/seed-demo.mjs, scripts/demo-images.mjs).
# Copy to .env and fill in. NEVER commit .env, NEVER expose the service role key to the frontend.
#
# Local stack (`supabase start` / `supabase status`):
#   SUPABASE_URL=http://127.0.0.1:54321
#   SUPABASE_SERVICE_ROLE_KEY=<"Secret" / service_role key printed by `supabase status`>
# Hosted project: Dashboard -> Project Settings -> API Keys.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Password given to every demo account created by scripts/seed-demo.mjs (min 8 chars).
DEMO_PASSWORD=

# Only for the public demo project: allows `seed-demo.mjs --reset --i-know-this-wipes`,
# which deletes every user, booking and file before re-seeding. Leave empty anywhere else.
DEMO_MODE=
